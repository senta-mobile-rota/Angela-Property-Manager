<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ange's Property Manager</title><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><style>:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#172333;background:#f4f7fb}*{box-sizing:border-box}body{margin:0}header{background:#142b46;color:white;padding:15px 20px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}h1{font-size:21px;margin:0}header small{color:#bdd1e7}button,.filelabel{border:0;background:#1769aa;color:white;padding:10px 13px;border-radius:9px;cursor:pointer;font-weight:650;font-size:14px}button.secondary,.filelabel{background:#e5edf6;color:#173a58}button.danger{background:#a52e38}button:disabled{opacity:.5}.layout{display:grid;grid-template-columns:minmax(270px,340px) 1fr;min-height:calc(100vh - 75px)}aside{padding:16px;background:white;border-right:1px solid #dce4ed;max-height:calc(100vh - 75px);overflow:auto}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:15px}.stat{border:1px solid #e0e6ee;border-radius:10px;padding:10px;background:#f9fbfd}.stat b{display:block;font-size:24px}.stat span{font-size:12px;color:#58677b}.filters{display:flex;flex-wrap:wrap;gap:5px;margin:10px 0}.filter{font-size:12px;padding:7px 9px;background:#e9eef5;color:#34475e}.filter.active{background:#173f66;color:white}input,select,textarea{width:100%;border:1px solid #cdd7e2;border-radius:8px;padding:10px;font:inherit;margin:4px 0 10px}label{font-size:13px;font-weight:650}#map{height:calc(100vh - 75px);min-height:450px}.item{padding:12px 3px;border-bottom:1px solid #e7ecf2;cursor:pointer}.item:hover{background:#f3f7fc}.item strong{font-size:14px}.item small{display:block;color:#66788d;margin-top:4px}.dot{display:inline-block;width:11px;height:11px;border-radius:50%;margin-right:7px}.pin{border:3px solid white;border-radius:50%;width:22px;height:22px;box-shadow:0 1px 7px #17233399}.modalbg{position:fixed;inset:0;background:#101c2c99;display:none;align-items:center;justify-content:center;z-index:2000;padding:15px}.modal{background:white;width:min(510px,100%);max-height:95vh;overflow:auto;border-radius:15px;padding:20px}.modal h2{margin:0 0 12px}.actions{display:flex;gap:8px;flex-wrap:wrap}.hint{font-size:12px;color:#607084;line-height:1.5}.notice{background:#fff6dc;padding:10px;border-radius:8px;color:#695016;font-size:12px;margin:12px 0}#statusline{font-size:12px;color:#50677e;margin-top:10px}@media(max-width:750px){.layout{display:flex;flex-direction:column}aside{max-height:none;order:2}#map{height:53vh;min-height:350px}header{padding:12px}h1{font-size:18px}}@media(min-width:751px){aside{order:0}}</style></head><body><header><div><h1>🏠 Ange's Property Manager</h1><small>Property map & status register · Prototype</small></div><div class="actions"><button id="add">+ Add property</button><button class="secondary" id="export">Export CSV</button></div></header><main class="layout"><aside><div class="stats"><div class="stat"><b id="total">0</b><span>Total properties</span></div><div class="stat"><b id="occupied">0</b><span>🟢 Occupied</span></div><div class="stat"><b id="offer">0</b><span>🟠 Offer in progress</span></div><div class="stat"><b id="maintenance">0</b><span>🔴 Maintenance needed</span></div><div class="stat"><b id="vacant">0</b><span>🔵 Vacant</span></div><div class="stat"><b id="works">0</b><span>🟣 Works underway</span></div></div><label for="search">Find property</label><input id="search" placeholder="Search address, postcode or reference"><div id="filters" class="filters"></div><div class="actions"><label class="filelabel" for="import">Import CSV</label><input id="import" type="file" accept=".csv,text/csv" style="display:none"><button class="secondary" id="reset">Reset demo</button></div><p class="hint">CSV columns: reference,address,postcode,status,latitude,longitude,notes. Import adds or updates records by reference. Latitude and longitude are needed to place markers; you can also use the address lookup when adding a property.</p><div class="notice">Demo only. Data is stored locally in this browser, not synced or backed up. Do not import real tenant details or confidential housing records.</div><h3>Property register <span id="count"></span></h3><div id="items"></div><div id="statusline"></div></aside><div id="map" aria-label="Interactive property map"></div></main><div class="modalbg" id="modalbg"><div class="modal" role="dialog" aria-modal="true" aria-labelledby="modaltitle"><h2 id="modaltitle">Add property</h2><form id="form"><input type="hidden" id="editing"><label>Property reference *</label><input id="reference" required maxlength="80" placeholder="PROP-301"><label>Address *</label><input id="address" required placeholder="12 Example Street, Swansea"><label>Postcode</label><input id="postcode" placeholder="SA1 1AA"><label>Occupancy / allocation status</label><select id="status"><option value="occupied">Occupied</option><option value="offer">Offer in progress</option><option value="vacant">Vacant</option></select><label>Maintenance status</label><select id="repair"><option value="none">No issue recorded</option><option value="maintenance">Maintenance needed</option><option value="works">Works underway</option></select><label>Latitude</label><input id="lat" type="number" step="any" min="-90" max="90" placeholder="51.62"><label>Longitude</label><input id="lng" type="number" step="any" min="-180" max="180" placeholder="-3.94"><button type="button" class="secondary" id="lookup">Find location from address</button><p class="hint" id="geohelp">Location lookup needs an internet connection and may require you to choose/check the correct address.</p><label>Notes (avoid personal or tenant information)</label><textarea id="notes" rows="3"></textarea><div class="actions"><button type="submit">Save property</button><button type="button" class="secondary" id="cancel">Cancel</button><button type="button" class="danger" id="delete" style="display:none">Delete</button></div></form></div></div><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script>
const KEY='ange_property_manager_v1';const colors={occupied:'#16a34a',offer:'#f59e0b',maintenance:'#dc2626',vacant:'#2785d1',works:'#8b5cf6'};const names={occupied:'Occupied',offer:'Offer in progress',maintenance:'Maintenance needed',vacant:'Vacant',works:'Works underway'};const demo=[{reference:'DEMO-001',address:'Example property — Swansea Marina',postcode:'SA1',status:'occupied',repair:'none',lat:51.6165,lng:-3.9365,notes:'Fictional demonstration marker'},{reference:'DEMO-002',address:'Example property — Uplands',postcode:'SA2',status:'offer',repair:'none',lat:51.6227,lng:-3.9638,notes:'Fictional demonstration marker'},{reference:'DEMO-003',address:'Example property — Morriston',postcode:'SA6',status:'occupied',repair:'maintenance',lat:51.6663,lng:-3.9277,notes:'Fictional demonstration marker'},{reference:'DEMO-004',address:'Example property — Sketty',postcode:'SA2',status:'vacant',repair:'none',lat:51.619,lng:-3.987,notes:'Fictional demonstration marker'},{reference:'DEMO-005',address:'Example property — Mumbles',postcode:'SA3',status:'occupied',repair:'works',lat:51.5767,lng:-3.9978,notes:'Fictional demonstration marker'}];let properties;try{let v=JSON.parse(localStorage.getItem(KEY));properties=Array.isArray(v)?v:structuredClone(demo)}catch{properties=structuredClone(demo)}let filter='all',markers={};const $=id=>document.getElementById(id);const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(properties));$('statusline').textContent='Saved locally on this device.'}catch(e){$('statusline').textContent='Unable to save: browser storage unavailable.'}};const effective=p=>p.repair!=='none'?p.repair:p.status;const map=L.map('map').setView([51.623,-3.945],11);const tiles=L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap contributors',maxZoom:19,crossOrigin:false}).addTo(map);tiles.on('tileerror',()=>{const el=document.getElementById('statusline');if(el)el.textContent='Map background could not load. Try opening this app in Chrome or Edge while online.'});window.addEventListener('load',()=>setTimeout(()=>map.invalidateSize(),250));const layer=L.layerGroup().addTo(map);function icon(color){return L.divIcon({className:'',html:`<div class="pin" style="background:${color}"></div>`,iconSize:[22,22],iconAnchor:[11,11]})}function openRecord(ref){const p=properties.find(x=>x.reference===ref);if(!p)return;openForm(p)}function render(){layer.clearLayers();markers={};for(const k of ['occupied','offer','maintenance','vacant','works'])$(k).textContent=properties.filter(p=>effective(p)===k).length;$('total').textContent=properties.length;const q=$('search').value.toLowerCase();const shown=properties.filter(p=>(filter==='all'||effective(p)===filter)&&[p.address,p.postcode,p.reference].join(' ').toLowerCase().includes(q));$('count').textContent=`(${shown.length})`;$('items').replaceChildren();for(const p of shown){const div=document.createElement('div');div.className='item';const title=document.createElement('strong');const dot=document.createElement('span');dot.className='dot';dot.style.background=colors[effective(p)];title.append(dot,document.createTextNode(p.address));const detail=document.createElement('small');detail.textContent=`${p.reference} · ${p.postcode||'No postcode'} · ${names[effective(p)]}`;div.append(title,detail);div.onclick=()=>{if(Number.isFinite(p.lat)&&Number.isFinite(p.lng)&&markers[p.reference]){map.setView([p.lat,p.lng],15);markers[p.reference].openPopup()}else openRecord(p.reference)};$('items').append(div);if(Number.isFinite(p.lat)&&Number.isFinite(p.lng)){const m=L.marker([p.lat,p.lng],{icon:icon(colors[effective(p)])}).addTo(layer);const popup=document.createElement('div');const heading=document.createElement('strong');heading.textContent=p.address;const sub=document.createElement('p');sub.textContent=`${p.reference} · ${names[effective(p)]}`;const btn=document.createElement('button');btn.textContent='View / edit';btn.onclick=()=>openRecord(p.reference);popup.append(heading,sub,btn);m.bindPopup(popup);markers[p.reference]=m}}}function openForm(p){$('form').reset();$('editing').value=p?.reference||'';$('modaltitle').textContent=p?'Edit property':'Add property';$('delete').style.display=p?'inline-block':'none';$('geohelp').textContent='Location lookup needs internet access. Verify the marker before saving.';for(const [id,key] of [['reference','reference'],['address','address'],['postcode','postcode'],['status','status'],['repair','repair'],['lat','lat'],['lng','lng'],['notes','notes']])$(id).value=p?.[key]??(id==='status'?'vacant':id==='repair'?'none':'');$('modalbg').style.display='flex'}function closeForm(){$('modalbg').style.display='none'}$('add').onclick=()=>openForm();$('cancel').onclick=closeForm;$('modalbg').onclick=e=>{if(e.target===$('modalbg'))closeForm()};$('form').onsubmit=e=>{e.preventDefault();const ref=$('reference').value.trim();const previous=$('editing').value;const dupe=properties.find(p=>p.reference===ref&&p.reference!==previous);if(dupe)return alert('That property reference already exists.');const lat=$('lat').value.trim(),lng=$('lng').value.trim();const p={reference:ref,address:$('address').value.trim(),postcode:$('postcode').value.trim(),status:$('status').value,repair:$('repair').value,lat:lat===''?null:Number(lat),lng:lng===''?null:Number(lng),notes:$('notes').value.trim()};if(previous)properties=properties.filter(x=>x.reference!==previous);properties.push(p);save();render();closeForm();if(p.lat!==null&&p.lng!==null)map.setView([p.lat,p.lng],15)};$('delete').onclick=()=>{if(confirm('Delete this property?')){properties=properties.filter(p=>p.reference!==$('editing').value);save();render();closeForm()}};$('lookup').onclick=async()=>{const query=[$('address').value,$('postcode').value,'Wales, UK'].filter(Boolean).join(', ');if(!$('address').value.trim())return alert('Enter an address first.');$('geohelp').textContent='Searching for address…';try{const r=await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q='+encodeURIComponent(query));if(!r.ok)throw Error('Lookup unavailable');const arr=await r.json();if(!arr.length)throw Error('No match found. Try a more complete address or enter coordinates manually.');$('lat').value=arr[0].lat;$('lng').value=arr[0].lon;$('geohelp').textContent='Possible match: '+arr[0].display_name+'. Verify the location on the map after saving.'}catch(e){$('geohelp').textContent=e.message}};$('search').oninput=render;for(const k of ['all','occupied','offer','maintenance','vacant','works']){const b=document.createElement('button');b.className='filter'+(k==='all'?' active':'');b.textContent=k==='all'?'All':names[k];b.onclick=()=>{filter=k;document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));b.classList.add('active');render()};$('filters').append(b)}function csvCell(x){return '"'+String(x??'').replaceAll('"','""')+'"'}$('export').onclick=()=>{const cols=['reference','address','postcode','status','repair','latitude','longitude','notes'];const lines=[cols.join(','),...properties.map(p=>[p.reference,p.address,p.postcode,p.status,p.repair,p.lat,p.lng,p.notes].map(csvCell).join(','))];const url=URL.createObjectURL(new Blob([lines.join('\r\n')],{type:'text/csv;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='anges_properties.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};function parseCSV(s){let rows=[],row=[],cell='',quoted=false;for(let i=0;i<s.length;i++){const c=s[i];if(c==='"'){if(quoted&&s[i+1]==='"'){cell+='"';i++}else quoted=!quoted}else if(c===','&&!quoted){row.push(cell);cell=''}else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&s[i+1]==='\n')i++;row.push(cell);if(row.some(x=>x.trim()))rows.push(row);row=[];cell=''}else cell+=c}if(quoted)throw Error('Unclosed quote in CSV');row.push(cell);if(row.some(x=>x.trim()))rows.push(row);return rows}$('import').onchange=async e=>{const file=e.target.files[0];if(!file)return;try{const rows=parseCSV((await file.text()).replace(/^\uFEFF/,''));const cols=rows.shift().map(x=>x.trim().toLowerCase());for(const c of ['reference','address','status'])if(!cols.includes(c))throw Error('Missing required CSV column: '+c);let added=0,updated=0,skipped=0;for(const row of rows){const v=Object.fromEntries(cols.map((c,i)=>[c,(row[i]||'').trim()]));if(!v.reference||!v.address||!['occupied','offer','vacant'].includes(v.status)||v.repair&&!['none','maintenance','works'].includes(v.repair)){skipped++;continue}const lat=v.latitude??v.lat??'',lng=v.longitude??v.lng??'';if(lat!==''&&(!Number.isFinite(Number(lat))||Number(lat)<-90||Number(lat)>90)||lng!==''&&(!Number.isFinite(Number(lng))||Number(lng)<-180||Number(lng)>180)){skipped++;continue}const p={reference:v.reference,address:v.address,postcode:v.postcode||'',status:v.status,repair:v.repair||'none',lat:lat===''?null:Number(lat),lng:lng===''?null:Number(lng),notes:v.notes||''};const index=properties.findIndex(x=>x.reference===p.reference);if(index>=0){properties[index]=p;updated++}else{properties.push(p);added++}}save();render();alert(`Import complete: ${added} added, ${updated} updated, ${skipped} skipped. Properties without coordinates are in the register but not yet on the map.`)}catch(err){alert('Import failed: '+err.message)}e.target.value=''};$('reset').onclick=()=>{if(confirm('Replace all locally saved properties with the five fictional demo properties? Export a backup first.')){properties=structuredClone(demo);save();render();map.setView([51.623,-3.945],11)}};render();</script></body></html>
